msgstr "Hidupkan semula CHIP Send di Settings → Payouts."

#: includes/class-chip-affiliatewp-admin.php:744
msgid "Two characters used to prefix CHIP Send references."
msgstr "Dua aksara yang digunakan sebagai awalan rujukan CHIP Send."

