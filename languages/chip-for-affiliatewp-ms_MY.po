#: includes/class-chip-affiliatewp-admin.php:196
#: includes/class-chip-affiliatewp-admin.php:693
#: includes/class-chip-affiliatewp-admin.php:700
#: includes/class-chip-affiliatewp-admin.php:768
#: includes/class-chip-affiliatewp-admin.php:835
msgid "Test Mode"
msgstr "Mod Ujian"

#: includes/class-chip-affiliatewp-admin.php:686
msgid ""
"Test Mode routes every payout through CHIP test credentials and never moves "
"real money."
msgstr ""
"Mod Ujian menghantar setiap pembayaran melalui kelayakan ujian CHIP dan "
"tidak sekali-kali memindahkan wang sebenar."

#: includes/class-chip-affiliatewp-admin.php:671
msgid "Test Secret Key"
msgstr "Kunci Rahsia Ujian"

#: includes/class-chip-affiliatewp-affiliate-area.php:233
msgid "That account number looks wrong"
msgstr "Nombor akaun itu kelihatan salah"

#: includes/class-chip-affiliatewp-affiliate-area.php:227
msgid "That bank is not supported"
msgstr "Bank itu tidak disokong"

#: includes/class-chip-affiliatewp-webhooks.php:491
msgid "The payload is missing a send instruction ID or state."
msgstr "Muatan tiada ID atau keadaan arahan penghantaran (send instruction)."

#: includes/class-chip-affiliatewp-payouts.php:1423
msgid ""
"The payout record could not be created. The referral may already have an "
"active payout."
msgstr ""
"Rekod pembayaran tidak dapat dicipta. Rujukan ini mungkin sudah mempunyai "
"pembayaran aktif."

#: includes/class-chip-affiliatewp-payouts.php:329
msgid "The referrals left in this payout have no payable amount."
msgstr ""
"Rujukan yang tinggal dalam pembayaran ini tiada jumlah yang boleh dibayar."

#: includes/class-chip-affiliatewp-payouts.php:119
#: includes/class-chip-affiliatewp-payouts.php:183
msgid "The specified payout does not exist."
msgstr "Pembayaran yang dinyatakan tidak wujud."

#: includes/class-chip-affiliatewp-payouts.php:1244
msgid "The specified referral does not exist."
msgstr "Rujukan yang dinyatakan tidak wujud."

#: includes/class-chip-affiliatewp-webhooks.php:144
msgid ""
"The webhook URL (%1$s) is not reachable: %2$s. The webhook was not "
"registered — fix site reachability or configure payouts without webhooks "
"(the hourly requery sweep still works)."
msgstr ""
"URL webhook (%1$s) tidak dapat dicapai: %2$s. Webhook tidak didaftarkan — "
"baiki kebolehcapaian laman atau konfigurasi pembayaran tanpa webhook (sapuan"
" requery setiap jam tetap berfungsi)."

#: includes/class-chip-affiliatewp-webhooks.php:123
msgid "The webhook URL is not publicly reachable from this site."
msgstr "URL webhook tidak dapat dicapai secara awam dari laman ini."

#: includes/class-chip-affiliatewp-webhook-reset.php:182
msgid "The webhook was removed but could not be registered again: %s"
msgstr "Webhook telah dibuang tetapi tidak dapat didaftarkan semula: %s"

#: includes/class-chip-affiliatewp-payouts.php:1256
msgid "There is no affiliate connected to this referral."
msgstr "Tiada afiliasi dikaitkan dengan rujukan ini."

#: includes/class-chip-affiliatewp-payouts.php:1344
msgid "This affiliate account does not have a payment email."
msgstr "Akaun afiliasi ini tiada e-mel pembayaran."

#: includes/class-chip-affiliatewp-admin.php:1135
msgid "This affiliate has bank details on file and can be paid via CHIP Send."
msgstr ""
"Afiliasi ini mempunyai butiran bank disimpan dan boleh dibayar melalui CHIP "
"Send."

#: includes/class-chip-affiliatewp-bank-accounts.php:431
msgid "This affiliate has no bank account details on file."
msgstr "Afiliasi ini tiada butiran akaun bank disimpan."

#: includes/class-chip-affiliatewp-admin.php:1136
msgid ""
"This affiliate has no bank code or account number on file, so a CHIP Send "
"payout would fail."
msgstr ""
"Afiliasi ini tiada kod bank atau nombor akaun disimpan, jadi pembayaran CHIP"
" Send akan gagal."

#: includes/class-chip-affiliatewp-payouts.php:235
msgid "This affiliate has no payment email on file."
msgstr "Afiliasi ini tiada e-mel pembayaran disimpan."

#: includes/class-chip-affiliatewp-admin.php:923
msgid ""
"This asks CHIP to convert part of your settlement balance into payout "
"budget. Approvers receive an email and approve there — nothing moves until "
"they do."
msgstr ""
"Ini meminta CHIP menukar sebahagian baki penyelesaian anda kepada bajet "
"pembayaran. Pelulus menerima e-mel dan meluluskan di sana — tiada apa "
"bergerak sehingga mereka luluskan."

#: includes/class-chip-affiliatewp-payouts.php:123
msgid "This payout is not a CHIP Send payout."
msgstr "Pembayaran ini bukan pembayaran CHIP Send."

#: includes/class-chip-affiliatewp-payouts.php:1252
